{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "commonjs",
    "moduleResolution": "node10",
    "types": [
      "jest",
      "node"
    ],
    "isolatedModules": true
  },
  "include": [
    "jest.config.cts",
    "jest.config.ts",
    "jest.integration.config.cts",
    "src/**/*.cts",
    "src/**/*.d.ts",
    "src/**/*.int-spec.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ]
}
