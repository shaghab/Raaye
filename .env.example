# Raaye local configuration. Copy to .env (`cp .env.example .env`, PowerShell:
# `Copy-Item .env.example .env`). Values below run the full local demo with the
# Firebase Authentication Emulator and the WhatsApp simulator. No cloud account,
# Meta account, or paid service is required.

# ---- Application -----------------------------------------------------------
APP_ENV=local                      # local | test | production
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:8080
API_PORT=3000
DEFAULT_TIMEZONE=Asia/Karachi

# ---- Database --------------------------------------------------------------
# Docker Compose overrides this to reach the `db` service. For host development
# (pnpm dev) point it at your local PostgreSQL.
DATABASE_URL=postgresql://raaye:raaye@127.0.0.1:5432/raaye
TEST_DATABASE_URL=postgresql://raaye:raaye@127.0.0.1:5432/raaye_test

# ---- Authentication --------------------------------------------------------
AUTH_MODE=emulator                 # emulator | live
FIREBASE_PROJECT_ID=demo-raaye
# Server-side emulator host (Docker hostname inside Compose; localhost on the host).
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Browser-side emulator URL used by the Angular app.
PUBLIC_AUTH_EMULATOR_URL=http://127.0.0.1:9099
# Firebase web API key. Any non-empty value works against the emulator.
PUBLIC_FIREBASE_API_KEY=demo-raaye-local-key

# ---- Messaging -------------------------------------------------------------
MESSAGING_MODE=mock                # mock | live
ENABLE_SIMULATOR=true              # must be false in live configuration
# Local-only demo bootstrap: seeds demo users/passwords. Must be false for live use.
ALLOW_DEMO_BOOTSTRAP=true

# ---- Jobs ------------------------------------------------------------------
JOB_DRIVER=postgres                # postgres | cloud_tasks
WORKER_POLL_INTERVAL_MS=1000
WORKER_BATCH_SIZE=10
WORKER_CONCURRENCY=4
JOB_LEASE_SECONDS=60
# Shared secret for /internal/* task routes in local mode (OIDC in cloud_tasks mode).
INTERNAL_TASK_TOKEN=local-internal-task-token-change-me

# ---- Retention -------------------------------------------------------------
IMPORT_STAGING_RETENTION_HOURS=24
RAW_WEBHOOK_RETENTION_DAYS=7
QUARANTINE_RETENTION_DAYS=7

# ---- Live WhatsApp (only read when MESSAGING_MODE=live) --------------------
# Provide secret *values* through the environment / Secret Manager, never in the UI.
# META_GRAPH_VERSION=v24.0
# META_APP_ID=
# META_APP_SECRET=
# META_ACCESS_TOKEN=
# META_WEBHOOK_VERIFY_TOKEN=
# META_WABA_ID=
# META_PHONE_NUMBER_ID=
# META_WEBHOOK_APP_KEY=

# ---- Cloud Tasks (only read when JOB_DRIVER=cloud_tasks) -------------------
# GCP_PROJECT_ID=
# CLOUD_TASKS_LOCATION=
# CLOUD_TASKS_QUEUE=
# WORKER_BASE_URL=https://raaye-worker-xxxx.run.app
# TASK_SERVICE_ACCOUNT_EMAIL=
