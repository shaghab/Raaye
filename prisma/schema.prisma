// Raaye logical data model. Every tenant-owned table carries organization_id and
// child rows reference parents through tenant-qualified composite foreign keys so a
// row in organization A can never point at a row in organization B.

generator client {
  provider     = "prisma-client"
  output       = "../libs/server/src/persistence/generated"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

