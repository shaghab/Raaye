  startedAt         DateTime           @map("started_at") @db.Timestamptz(6)
  completedAt       DateTime?          @map("completed_at") @db.Timestamptz(6)
  completionAckedAt DateTime?          @map("completion_acked_at") @db.Timestamptz(6)
  currentQuestionId String?            @map("current_question_id") @db.Uuid
  analysisProfile   Json?              @map("analysis_profile")
  analysisProfileAt DateTime?          @map("analysis_profile_at") @db.Timestamptz(6)
  lastInboundAt     DateTime?          @map("last_inbound_at") @db.Timestamptz(6)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
