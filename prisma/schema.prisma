  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id])
  connection   MessagingConnection @relation(fields: [organizationId, connectionId], references: [organizationId, id])

  @@unique([organizationId, connectionId, purpose, locale])
  @@map("flow_bindings")
}

model Message {
  id                String        @id @default(uuid()) @db.Uuid
  organizationId    String        @map("organization_id") @db.Uuid
  connectionId      String        @map("connection_id") @db.Uuid
  contactId         String        @map("contact_id") @db.Uuid
  runId             String?       @map("run_id") @db.Uuid
  participationId   String?       @map("participation_id") @db.Uuid
  snapshotId        String?       @map("snapshot_id") @db.Uuid
  dedupeKey         String        @unique @map("dedupe_key")
  kind              MessageKind
  state             MessageState  @default(PENDING)
  deliveryState     DeliveryState @default(QUEUED) @map("delivery_state")
  rendered          Json
  isFreeForm        Boolean       @default(true) @map("is_free_form")
  isTest            Boolean       @default(false) @map("is_test")
  providerMessageId String?       @map("provider_message_id")
  suppressionReason String?       @map("suppression_reason")
  lastErrorCode     String?       @map("last_error_code")
  lastStatusAt      DateTime?     @map("last_status_at") @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization         @relation(fields: [organizationId], references: [id])
  connection    MessagingConnection  @relation(fields: [organizationId, connectionId], references: [organizationId, id])
  contact       Contact              @relation(fields: [organizationId, contactId], references: [organizationId, id])
  run           SurveyRun?           @relation(fields: [organizationId, runId], references: [organizationId, id])
  participation Participation?       @relation(fields: [organizationId, participationId], references: [organizationId, id])
  snapshot      ResultSnapshot?      @relation(fields: [organizationId, snapshotId], references: [organizationId, id])
  attempts      MessageAttempt[]
  statusEvents  MessageStatusEvent[]
  invitations   Invitation[]
  resultInvites ResultRecipient[]    @relation("ResultInvitationMessage")

  @@unique([organizationId, id])
  @@index([organizationId, runId, kind])
  @@index([organizationId, contactId, createdAt(sort: Desc)])
  @@index([organizationId, connectionId, providerMessageId])
  @@index([organizationId, state])
  @@map("messages")
}

model MessageAttempt {
  id                 String         @id @default(uuid()) @db.Uuid
  organizationId     String         @map("organization_id") @db.Uuid
  messageId          String         @map("message_id") @db.Uuid
  attemptNumber      Int            @map("attempt_number")
  startedAt          DateTime       @map("started_at") @db.Timestamptz(6)
  finishedAt         DateTime?      @map("finished_at") @db.Timestamptz(6)
  outcome            AttemptOutcome @default(IN_FLIGHT)
  providerMessageId  String?        @map("provider_message_id")
  errorCode          String?        @map("error_code")
  errorDetail        String?        @map("error_detail")
  retryable          Boolean?
  authorizedByUserId String?        @map("authorized_by_user_id") @db.Uuid
  leaseOwner         String?        @map("lease_owner")

  organization Organization @relation(fields: [organizationId], references: [id])
  message      Message      @relation(fields: [organizationId, messageId], references: [organizationId, id])

  @@unique([organizationId, messageId, attemptNumber])
  @@index([organizationId, providerMessageId])
  @@map("message_attempts")
}

model MessageStatusEvent {
  id                String         @id @default(uuid()) @db.Uuid
  organizationId    String         @map("organization_id") @db.Uuid
  connectionId      String         @map("connection_id") @db.Uuid
  providerMessageId String         @map("provider_message_id")
  messageId         String?        @map("message_id") @db.Uuid
  status            ProviderStatus
  providerAt        DateTime       @map("provider_at") @db.Timestamptz(6)
  receivedAt        DateTime       @default(now()) @map("received_at") @db.Timestamptz(6)
  errorCode         String?        @map("error_code")
  errorTitle        String?        @map("error_title")
  reconciledAt      DateTime?      @map("reconciled_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id])
  connection   MessagingConnection @relation(fields: [organizationId, connectionId], references: [organizationId, id])
  message      Message?            @relation(fields: [organizationId, messageId], references: [organizationId, id])

  @@unique([organizationId, connectionId, providerMessageId, status, providerAt])
  @@index([organizationId, messageId])
  @@index([organizationId, reconciledAt])
  @@map("message_status_events")
}

model InboundEvent {
  id                String                 @id @default(uuid()) @db.Uuid
  organizationId    String                 @map("organization_id") @db.Uuid
  connectionId      String                 @map("connection_id") @db.Uuid
  providerMessageId String                 @map("provider_message_id")
  senderIdentity    String                 @map("sender_identity")
  senderProfileName String?                @map("sender_profile_name")
  kind              InboundKind
  normalized        Json
  providerAt        DateTime               @map("provider_at") @db.Timestamptz(6)
  receivedAt        DateTime               @default(now()) @map("received_at") @db.Timestamptz(6)
  ingressSequence   BigInt                 @default(autoincrement()) @map("ingress_sequence")
  processingState   InboundProcessingState @default(PENDING) @map("processing_state")
  processedAt       DateTime?              @map("processed_at") @db.Timestamptz(6)
  outcomeCode       String?                @map("outcome_code")
  rawPayload        Json?                  @map("raw_payload")
  rawExpiresAt      DateTime?              @map("raw_expires_at") @db.Timestamptz(6)
