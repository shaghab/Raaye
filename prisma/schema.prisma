  connection   MessagingConnection @relation(fields: [organizationId, connectionId], references: [organizationId, id])

  @@unique([organizationId, connectionId, providerMessageId])
  @@index([organizationId, processingState, receivedAt])
  @@index([rawExpiresAt])
  @@map("inbound_events")
}

model WebhookQuarantine {
  id            String   @id @default(uuid()) @db.Uuid
  appKey        String   @map("app_key")
  reason        String
  phoneNumberId String?  @map("phone_number_id")
  rawPayload    Json     @map("raw_payload")
  receivedAt    DateTime @default(now()) @map("received_at") @db.Timestamptz(6)
  expiresAt     DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("webhook_quarantine")
}

// ---------------------------------------------------------------------------
