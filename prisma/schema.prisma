// ---------------------------------------------------------------------------
// Control plane: organizations, users, memberships
// ---------------------------------------------------------------------------

model Organization {
  id                       String   @id @default(uuid()) @db.Uuid
  name                     String
  slug                     String   @unique
  timezone                 String   @default("Asia/Karachi")
  defaultLocale            String   @default("en") @map("default_locale")
  privacyUrl               String?  @map("privacy_url")
  supportContact           String?  @map("support_contact")
  participantNotice        String   @map("participant_notice")
  participantNoticeVersion Int      @default(1) @map("participant_notice_version")
  profileOnboardingEnabled Boolean  @default(true) @map("profile_onboarding_enabled")
  defaultDurationSeconds   Int      @default(172800) @map("default_duration_seconds")
  defaultEditWindowSeconds Int      @default(120) @map("default_edit_window_seconds")
  livePolicyReviewedAt     DateTime? @map("live_policy_reviewed_at") @db.Timestamptz(6)
  livePolicyReviewedById   String?  @map("live_policy_reviewed_by_id") @db.Uuid
  isDemo                   Boolean  @default(false) @map("is_demo")
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships         OrganizationMembership[]
  staffInvitations    StaffInvitation[]
  contacts            Contact[]
  consentEvents       ConsentEvent[]
  groups              Group[]
  tags                Tag[]
  contactGroups       ContactGroup[]
  contactTags         ContactTag[]
  enrollments         Enrollment[]
  surveys             Survey[]
  surveyRevisions     SurveyRevision[]
  questions           Question[]
  questionOptions     QuestionOption[]
  surveyRuns          SurveyRun[]
  surveyRecipients    SurveyRecipient[]
  invitations         Invitation[]
  participations      Participation[]
  conversations       Conversation[]
  answers             Answer[]
  answerRevisions     AnswerRevision[]
  answerSelections    AnswerSelection[]
  actionBindings      ActionBinding[]
  connections         MessagingConnection[]
  templateBindings    TemplateBinding[]
  flowBindings        FlowBinding[]
  messages            Message[]
  messageAttempts     MessageAttempt[]
  messageStatusEvents MessageStatusEvent[]
  inboundEvents       InboundEvent[]
  jobs                Job[]
  resultSnapshots     ResultSnapshot[]
  resultRecipients    ResultRecipient[]
  auditEvents         AuditEvent[]
  importBatches       ImportBatch[]
  importRows          ImportRow[]
  idempotencyKeys     IdempotencyKey[]

  @@map("organizations")
}

model User {
  id          String    @id @default(uuid()) @db.Uuid
  firebaseUid String    @unique @map("firebase_uid")
  email       String    @unique
  displayName String?   @map("display_name")
  state       UserState @default(ACTIVE)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships OrganizationMembership[]

  @@map("users")
}

model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           Role
  status         MembershipStatus @default(ACTIVE)
  revokedAt      DateTime?        @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@unique([organizationId, id])
  @@index([userId, status])
  @@index([organizationId, role, status])
  @@map("organization_memberships")
}

model StaffInvitation {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  email            String
  role             Role
  tokenHash        String    @unique @map("token_hash")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt       DateTime? @map("accepted_at") @db.Timestamptz(6)
  acceptedByUserId String?   @map("accepted_by_user_id") @db.Uuid
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  invitedByUserId  String    @map("invited_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, email])
  @@map("staff_invitations")
}

// ---------------------------------------------------------------------------
// Contacts, consent, groups and tags
// ---------------------------------------------------------------------------

model Contact {
  id                       String          @id @default(uuid()) @db.Uuid
  organizationId           String          @map("organization_id") @db.Uuid
  name                     String
  phoneE164                String          @map("phone_e164")
  providerIdentity         String?         @map("provider_identity")
  city                     String?
  cityNormalized           String?         @map("city_normalized")
  district                 String?
  districtNormalized       String?         @map("district_normalized")
  gender                   Gender?
  ageBand                  AgeBand?        @map("age_band")
  ageYears                 Int?            @map("age_years")
  ageAsOf                  DateTime?       @map("age_as_of") @db.Date
  occupation               String?
  membership               MembershipKind  @default(UNKNOWN)
  membershipSource         ValueSource?    @map("membership_source")
  selfReportedMembership   MembershipKind? @map("self_reported_membership")
  selfReportedMembershipAt DateTime?       @map("self_reported_membership_at") @db.Timestamptz(6)
  profileProvenance        Json?           @map("profile_provenance")
  preferredLocale          String          @default("en") @map("preferred_locale")
  consentInvitations       ConsentStatus   @default(UNKNOWN) @map("consent_invitations")
  consentInvitationsAt     DateTime?       @map("consent_invitations_at") @db.Timestamptz(6)
  consentResults           ConsentStatus   @default(UNKNOWN) @map("consent_results")
  consentResultsAt         DateTime?       @map("consent_results_at") @db.Timestamptz(6)
  isSynthetic              Boolean         @default(false) @map("is_synthetic")
  archivedAt               DateTime?       @map("archived_at") @db.Timestamptz(6)
  createdByUserId          String?         @map("created_by_user_id") @db.Uuid
  importBatchId            String?         @map("import_batch_id") @db.Uuid
  createdAt                DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization     Organization      @relation(fields: [organizationId], references: [id])
  consentEvents    ConsentEvent[]
  groups           ContactGroup[]
  tags             ContactTag[]
  recipients       SurveyRecipient[]
  invitations      Invitation[]
  participations   Participation[]
  conversations    Conversation[]
  actionBindings   ActionBinding[]
  messages         Message[]
  resultRecipients ResultRecipient[]
  importRows       ImportRow[]

  @@unique([organizationId, phoneE164])
  @@unique([organizationId, id])
  @@index([organizationId, name])
  @@index([organizationId, archivedAt])
  @@index([organizationId, providerIdentity])
  @@index([organizationId, consentInvitations, archivedAt])
  @@map("contacts")
}

model ConsentEvent {
  id                String           @id @default(uuid()) @db.Uuid
  organizationId    String           @map("organization_id") @db.Uuid
  contactId         String           @map("contact_id") @db.Uuid
  scope             ConsentScope
  type              ConsentEventType
  source            ConsentSource
  evidenceAt        DateTime         @map("evidence_at") @db.Timestamptz(6)
  recordedAt        DateTime         @default(now()) @map("recorded_at") @db.Timestamptz(6)
  wordingVersion    String?          @map("wording_version")
  evidenceReference String?          @map("evidence_reference")
  actorUserId       String?          @map("actor_user_id") @db.Uuid
  importBatchId     String?          @map("import_batch_id") @db.Uuid
  note              String?

  organization Organization @relation(fields: [organizationId], references: [id])
  contact      Contact      @relation(fields: [organizationId, contactId], references: [organizationId, id])

  @@index([organizationId, contactId, scope, evidenceAt(sort: Desc), recordedAt(sort: Desc)])
  @@map("consent_events")
}

model Group {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  normalizedName String   @map("normalized_name")
  description    String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization   @relation(fields: [organizationId], references: [id])
  contacts     ContactGroup[]

  @@unique([organizationId, normalizedName])
  @@unique([organizationId, id])
  @@map("groups")
}

model Tag {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  normalizedName String   @map("normalized_name")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  contacts     ContactTag[]

  @@unique([organizationId, normalizedName])
  @@unique([organizationId, id])
  @@map("tags")
}

model ContactGroup {
  organizationId String   @map("organization_id") @db.Uuid
  contactId      String   @map("contact_id") @db.Uuid
  groupId        String   @map("group_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  contact      Contact      @relation(fields: [organizationId, contactId], references: [organizationId, id])
  group        Group        @relation(fields: [organizationId, groupId], references: [organizationId, id])

  @@id([organizationId, contactId, groupId])
  @@index([organizationId, groupId])
  @@map("contact_groups")
}

model ContactTag {
  organizationId String   @map("organization_id") @db.Uuid
  contactId      String   @map("contact_id") @db.Uuid
  tagId          String   @map("tag_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  contact      Contact      @relation(fields: [organizationId, contactId], references: [organizationId, id])
  tag          Tag          @relation(fields: [organizationId, tagId], references: [organizationId, id])

  @@id([organizationId, contactId, tagId])
  @@index([organizationId, tagId])
  @@map("contact_tags")
}

model Enrollment {
  id                 String          @id @default(uuid()) @db.Uuid
  organizationId     String          @map("organization_id") @db.Uuid
  connectionId       String          @map("connection_id") @db.Uuid
  senderIdentity     String          @map("sender_identity")
  state              EnrollmentState
  proposedName       String?         @map("proposed_name")
  profileDisplayName String?         @map("profile_display_name")
  noticeVersion      Int             @map("notice_version")
  lastInboundAt      DateTime        @map("last_inbound_at") @db.Timestamptz(6)
  expiresAt          DateTime        @map("expires_at") @db.Timestamptz(6)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id])
  connection   MessagingConnection @relation(fields: [organizationId, connectionId], references: [organizationId, id])

  @@unique([organizationId, connectionId, senderIdentity])
  @@map("enrollments")
}

// ---------------------------------------------------------------------------
// Surveys
// ---------------------------------------------------------------------------

model Survey {
  id                    String      @id @default(uuid()) @db.Uuid
  organizationId        String      @map("organization_id") @db.Uuid
  internalTitle         String      @map("internal_title")
  state                 SurveyState @default(DRAFT)
  currentRevisionNumber Int         @default(1) @map("current_revision_number")
  archivedAt            DateTime?   @map("archived_at") @db.Timestamptz(6)
  authorUserId          String?     @map("author_user_id") @db.Uuid
  clonedFromSurveyId    String?     @map("cloned_from_survey_id") @db.Uuid
  createdAt             DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id])
  revisions    SurveyRevision[]
  runs         SurveyRun[]
  snapshots    ResultSnapshot[]

  @@unique([organizationId, id])
  @@index([organizationId, state, archivedAt])
  @@index([organizationId, updatedAt(sort: Desc)])
  @@map("surveys")
}

model SurveyRevision {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  surveyId           String    @map("survey_id") @db.Uuid
  revisionNumber     Int       @map("revision_number")
  frozenAt           DateTime? @map("frozen_at") @db.Timestamptz(6)
  locale             String    @default("en")
  title              Json
  introduction       Json
  editWindowSeconds  Int       @map("edit_window_seconds")
  durationSeconds    Int       @map("duration_seconds")
  explicitClosesAt   DateTime? @map("explicit_closes_at") @db.Timestamptz(6)
  scheduledOpensAt   DateTime? @map("scheduled_opens_at") @db.Timestamptz(6)
  audienceDefinition Json      @map("audience_definition")
  rendererPlan       Json?     @map("renderer_plan")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization    @relation(fields: [organizationId], references: [id])
  survey         Survey          @relation(fields: [organizationId, surveyId], references: [organizationId, id])
  questions      Question[]
  runs           SurveyRun[]
  participations Participation[]
  answers        Answer[]

  @@unique([organizationId, surveyId, revisionNumber])
  @@unique([organizationId, id])
  @@map("survey_revisions")
}

model Question {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  revisionId     String         @map("revision_id") @db.Uuid
  position       Int
  type           QuestionType
  preset         QuestionPreset @default(CUSTOM)
  prompt         Json
  minSelections  Int?           @map("min_selections")
  maxSelections  Int?           @map("max_selections")
  ratingMinLabel Json?          @map("rating_min_label")
  ratingMaxLabel Json?          @map("rating_max_label")
  renderer       String?
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization    Organization     @relation(fields: [organizationId], references: [id])
  revision        SurveyRevision   @relation(fields: [organizationId, revisionId], references: [organizationId, id])
  options         QuestionOption[]
  answers         Answer[]
  answerRevisions AnswerRevision[]
  actionBindings  ActionBinding[]

  @@unique([organizationId, revisionId, position])
  @@unique([organizationId, id])
  @@unique([organizationId, revisionId, id])
  @@map("questions")
}

model QuestionOption {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  questionId     String   @map("question_id") @db.Uuid
  code           String
  position       Int
  label          Json
  shortLabel     Json?    @map("short_label")
  ratingValue    Int?     @map("rating_value")
  exclusive      Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization      @relation(fields: [organizationId], references: [id])
  question     Question          @relation(fields: [organizationId, questionId], references: [organizationId, id])
  selections   AnswerSelection[]
  actions      ActionBinding[]

  @@unique([organizationId, questionId, position])
  @@unique([organizationId, questionId, code])
  @@unique([organizationId, questionId, id])
  @@map("question_options")
}

model SurveyRun {
  id                   String    @id @default(uuid()) @db.Uuid
  organizationId       String    @map("organization_id") @db.Uuid
  surveyId             String    @map("survey_id") @db.Uuid
  revisionId           String    @map("revision_id") @db.Uuid
  kind                 RunKind
  liveSlot             Int?      @map("live_slot")
  state                RunState
  opensAt              DateTime  @map("opens_at") @db.Timestamptz(6)
  closesAt             DateTime  @map("closes_at") @db.Timestamptz(6)
  activatedAt          DateTime? @map("activated_at") @db.Timestamptz(6)
  closedAt             DateTime? @map("closed_at") @db.Timestamptz(6)
  closeReason          String?   @map("close_reason")
  audienceDefinition   Json      @map("audience_definition")
  audienceSummary      Json      @map("audience_summary")
  launchIdempotencyKey String?   @map("launch_idempotency_key")
  launchedByUserId     String?   @map("launched_by_user_id") @db.Uuid
  dispatchBlockReason  String?   @map("dispatch_block_reason")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization      @relation(fields: [organizationId], references: [id])
  survey         Survey            @relation(fields: [organizationId, surveyId], references: [organizationId, id])
  revision       SurveyRevision    @relation(fields: [organizationId, revisionId], references: [organizationId, id])
  recipients     SurveyRecipient[]
  invitations    Invitation[]
  participations Participation[]
  actionBindings ActionBinding[]
  messages       Message[]
  snapshots      ResultSnapshot[]

  @@unique([organizationId, surveyId, liveSlot])
  @@unique([organizationId, id])
  @@index([organizationId, state, opensAt])
  @@index([organizationId, state, closesAt])
  @@map("survey_runs")
}

model SurveyRecipient {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  runId            String    @map("run_id") @db.Uuid
  contactId        String    @map("contact_id") @db.Uuid
  eligibleAtFreeze Boolean   @map("eligible_at_freeze")
  exclusionReason  String?   @map("exclusion_reason")
  audienceSnapshot Json      @map("audience_snapshot")
  suppressedAt     DateTime? @map("suppressed_at") @db.Timestamptz(6)
  suppressedReason String?   @map("suppressed_reason")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  run          SurveyRun    @relation(fields: [organizationId, runId], references: [organizationId, id])
  contact      Contact      @relation(fields: [organizationId, contactId], references: [organizationId, id])
  invitation   Invitation?

  @@unique([organizationId, runId, contactId])
  @@unique([organizationId, id])
  @@index([organizationId, contactId])
  @@map("survey_recipients")
}

model Invitation {
