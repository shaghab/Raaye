model ActionBinding {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  token           String        @unique
  purpose         ActionPurpose
  mode            ActionMode
  connectionId    String        @map("connection_id") @db.Uuid
  contactId       String        @map("contact_id") @db.Uuid
  runId           String?       @map("run_id") @db.Uuid
  participationId String?       @map("participation_id") @db.Uuid
  questionId      String?       @map("question_id") @db.Uuid
  optionId        String?       @map("option_id") @db.Uuid
  snapshotId      String?       @map("snapshot_id") @db.Uuid
  payload         Json?
  expiresAt       DateTime      @map("expires_at") @db.Timestamptz(6)
  consumedAt      DateTime?     @map("consumed_at") @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  organization  Organization        @relation(fields: [organizationId], references: [id])
  connection    MessagingConnection @relation(fields: [organizationId, connectionId], references: [organizationId, id])
  contact       Contact             @relation(fields: [organizationId, contactId], references: [organizationId, id])
  run           SurveyRun?          @relation(fields: [organizationId, runId], references: [organizationId, id])
  participation Participation?      @relation(fields: [organizationId, participationId], references: [organizationId, id])
  question      Question?           @relation(fields: [organizationId, questionId], references: [organizationId, id])
  option        QuestionOption?     @relation(fields: [organizationId, questionId, optionId], references: [organizationId, questionId, id])
  snapshot      ResultSnapshot?     @relation(fields: [organizationId, snapshotId], references: [organizationId, id])

  @@index([organizationId, contactId, purpose])
  @@index([expiresAt])
  @@map("action_bindings")
}

model MessagingConnection {
  id                 String            @id @default(uuid()) @db.Uuid
  organizationId     String            @map("organization_id") @db.Uuid
  provider           MessagingProvider
  mode               ConnectionMode
  appKey             String            @unique @map("app_key")
  phoneNumberId      String?           @map("phone_number_id")
  wabaId             String?           @map("waba_id")
  appId              String?           @map("app_id")
  displayPhoneNumber String?           @map("display_phone_number")
  graphVersion       String?           @map("graph_version")
  appSecretRef       String?           @map("app_secret_ref")
  accessTokenRef     String?           @map("access_token_ref")
  verifyTokenRef     String?           @map("verify_token_ref")
  enabled            Boolean           @default(true)
  readinessState     String?           @map("readiness_state")
  readinessDetail    Json?             @map("readiness_detail")
  lastCheckedAt      DateTime?         @map("last_checked_at") @db.Timestamptz(6)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization     Organization         @relation(fields: [organizationId], references: [id])
  templateBindings TemplateBinding[]
  flowBindings     FlowBinding[]
  messages         Message[]
  statusEvents     MessageStatusEvent[]
  inboundEvents    InboundEvent[]
  enrollments      Enrollment[]
  conversations    Conversation[]
  actionBindings   ActionBinding[]

  @@unique([organizationId, id])
  @@unique([phoneNumberId])
  @@map("messaging_connections")
}

model TemplateBinding {
  id               String          @id @default(uuid()) @db.Uuid
  organizationId   String          @map("organization_id") @db.Uuid
  connectionId     String          @map("connection_id") @db.Uuid
  purpose          TemplatePurpose
