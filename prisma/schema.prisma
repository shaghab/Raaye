  columnMapping      Json?          @map("column_mapping")
  defaultCountry     String         @default("PK") @map("default_country")
  duplicateMode      DuplicateMode  @default(SKIP_EXISTING) @map("duplicate_mode")
  consentAttestation Json?          @map("consent_attestation")
  state              ImportState    @default(UPLOADED)
  summary            Json?
  rawBytes           Bytes?         @map("raw_bytes")
  rawExpiresAt       DateTime       @map("raw_expires_at") @db.Timestamptz(6)
  stagingPurgedAt    DateTime?      @map("staging_purged_at") @db.Timestamptz(6)
  previewedAt        DateTime?      @map("previewed_at") @db.Timestamptz(6)
  confirmedAt        DateTime?      @map("confirmed_at") @db.Timestamptz(6)
  completedAt        DateTime?      @map("completed_at") @db.Timestamptz(6)
  errorMessage       String?        @map("error_message")
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  rows         ImportRow[]

  @@unique([organizationId, id])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([rawExpiresAt])
  @@map("import_batches")
}

model ImportRow {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  batchId        String          @map("batch_id") @db.Uuid
  rowNumber      Int             @map("row_number")
  status         ImportRowStatus
  errors         Json?
  normalized     Json?
  contactId      String?         @map("contact_id") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id])
  batch        ImportBatch  @relation(fields: [organizationId, batchId], references: [organizationId, id])
  contact      Contact?     @relation(fields: [organizationId, contactId], references: [organizationId, id])

  @@unique([organizationId, batchId, rowNumber])
  @@index([organizationId, batchId, status])
  @@map("import_rows")
}

model IdempotencyKey {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  scope          String
  key            String
  requestHash    String   @map("request_hash")
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, scope, key])
  @@map("idempotency_keys")
}

model SimulatorState {
  id                 Int      @id @default(1)
  clockOffsetSeconds Int      @default(0) @map("clock_offset_seconds")
  faults             Json     @default("{}")
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("simulator_state")
}
