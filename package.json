{
  "name": "raaye",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Raaye: permission-based WhatsApp surveys for organizations (MVP).",
  "engines": {
    "node": ">=22.12.0 <23 || >=24.0.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "lint": "nx run-many -t lint --parallel=3",
    "typecheck": "nx run-many -t typecheck --parallel=3",
    "test": "nx run-many -t test --parallel=2",
    "test:integration": "nx run-many -t test-integration --parallel=1",
    "test:e2e": "nx run web-e2e:e2e",
    "build": "nx run-many -t build --configuration=production --parallel=2",
    "dev": "tsx --tsconfig tsconfig.base.json scripts/dev.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:reset": "tsx --tsconfig tsconfig.base.json scripts/db-reset.ts",
    "db:seed": "tsx --tsconfig tsconfig.base.json scripts/run-cli.ts seed",
    "seed:scale": "tsx --tsconfig tsconfig.base.json scripts/run-cli.ts seed:scale",
    "verify": "tsx --tsconfig tsconfig.base.json scripts/verify.ts",
    "whatsapp:validate": "tsx --tsconfig tsconfig.base.json scripts/whatsapp-validate.ts",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@angular/animations": "21.2.25",
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/material": "21.2.14",
    "@angular/platform-browser": "21.2.25",
    "@angular/router": "21.2.25",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "express": "5.2.1",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "firebase": "12.19.0",
    "firebase-admin": "14.5.0",
    "google-auth-library": "11.1.0",
    "helmet": "8.3.0",
    "libphonenumber-js": "1.13.14",
    "luxon": "3.7.2",
    "nestjs-zod": "5.5.0",
    "papaparse": "5.7.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "prisma": "7.10.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@angular-devkit/core": "21.2.25",
    "@angular-devkit/schematics": "21.2.25",
    "@angular/build": "21.2.25",
    "@angular/cli": "21.2.25",
    "@angular/compiler-cli": "21.2.25",
    "@eslint/js": "10.0.1",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.7",
    "@nx/angular": "23.2.1",
    "@nx/devkit": "23.2.1",
    "@nx/eslint": "23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/jest": "23.2.1",
    "@nx/js": "23.2.1",
    "@nx/nest": "23.2.1",
    "@nx/node": "23.2.1",
    "@nx/playwright": "23.2.1",
    "@nx/web": "23.2.1",
    "@nx/webpack": "23.2.1",
    "@nx/workspace": "23.2.1",
    "@playwright/test": "1.63.0",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.7",
    "@schematics/angular": "21.2.25",
    "@svgr/webpack": "^8.0.1",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.16.13",
    "@swc/helpers": "0.5.23",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/luxon": "3.7.6",
    "@types/node": "22.20.5",
    "@types/papaparse": "5.5.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@typescript-eslint/utils": "^8.58.0",
    "angular-eslint": "21.4.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "1.8.3",
    "firebase-tools": "15.32.1",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "jest-environment-node": "30.5.2",
    "jest-preset-angular": "17.0.2",
